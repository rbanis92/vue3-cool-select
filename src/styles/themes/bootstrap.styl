// Bootstrap theme. The box has the measures of Bootstrap 4 ".form-control" (also -sm and -lg,
// .is-valid and .is-invalid), the menu follows ".dropdown-menu".
// Every value can be changed by setting the custom property on .IZ-select and .IZ-select__menu.
@import "../common/main.styl"

.IZ-select,
.IZ-select__menu
  --iz-font-family: inherit
  --iz-font-size: 1rem
  --iz-font-weight: 400
  --iz-line-height: 1.5

  // in rem (not em), so the value is the same wherever it is used: 1.5 * font-size + padding + border
  --iz-height: calc(1.5rem + .75rem + 2px)
  --iz-padding-x: .75rem
  --iz-color: #495057
  --iz-placeholder-color: #6c757d
  --iz-muted-color: #6c757d
  --iz-bg: #fff
  --iz-border-width: 1px
  --iz-border-color: #ced4da
  --iz-radius: .25rem
  --iz-shadow: none
  --iz-transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out

  --iz-focus-border-color: #80bdff
  --iz-focus-shadow: 0 0 0 .2rem rgba(0, 123, 255, .25)
  --iz-error-color: #dc3545
  --iz-error-focus-shadow: 0 0 0 .2rem rgba(220, 53, 69, .25)
  --iz-error-font-size: .875em
  --iz-error-margin: .25rem
  --iz-error-padding: 0
  --iz-success-color: #28a745
  --iz-success-focus-shadow: 0 0 0 .2rem rgba(40, 167, 69, .25)

  --iz-disabled-bg: #e9ecef
  --iz-disabled-color: #495057
  --iz-disabled-placeholder-color: #6c757d
  --iz-disabled-shadow: none
  --iz-readonly-bg: #e9ecef

  --iz-icon-color: #6c757d
  --iz-icon-hover-color: #212529
  --iz-icon-hover-bg: rgba(0, 0, 0, .08)
  --iz-spinner-color: #007bff
  --iz-spinner-track-color: rgba(0, 0, 0, .1)

  --iz-chip-gap: 6px
  --iz-chip-padding-x: .5em
  --iz-chip-font-size: .875em
  --iz-chip-color: #495057
  --iz-chip-bg: #e9ecef
  --iz-chip-border: 1px solid #dee2e6
  --iz-chip-radius: .2rem

  --iz-menu-z-index: 1060
  --iz-menu-offset: .125rem
  --iz-menu-padding: .5rem
  --iz-menu-bg: #fff
  --iz-menu-border: 1px solid rgba(0, 0, 0, .15)
  --iz-menu-radius: .25rem
  --iz-menu-shadow: 0 .5rem 1rem rgba(0, 0, 0, .175)

  --iz-item-padding-y: .375rem
  --iz-item-padding-x: .75rem
  --iz-item-color: #212529
  --iz-item-hover-bg: #f8f9fa
  --iz-item-highlight-bg: #e9ecef
  --iz-item-selected-color: #007bff
  --iz-item-selected-bg: rgba(0, 123, 255, .08)
  --iz-item-disabled-color: #adb5bd

  --iz-group-padding: .5rem .75rem .25rem
  --iz-group-font-size: .875em
  --iz-group-font-weight: 400
  --iz-group-color: #6c757d

.IZ-select--sm,
.IZ-select__menu--sm
  --iz-font-size: .875rem
  --iz-height: calc(1.3125rem + .5rem + 2px)
  --iz-padding-x: .5rem
  --iz-radius: .2rem
  --iz-chip-gap: 4px
  --iz-item-padding-y: .25rem
  --iz-item-padding-x: .5rem
  --iz-group-padding: .375rem .5rem .125rem
  --iz-menu-padding: .25rem

.IZ-select--lg,
.IZ-select__menu--lg
  --iz-font-size: 1.25rem
  --iz-height: calc(1.875rem + 1rem + 2px)
  --iz-padding-x: 1rem
  --iz-radius: .3rem
  --iz-chip-gap: 8px
  --iz-item-padding-y: .5rem
  --iz-item-padding-x: 1rem
  --iz-group-padding: .625rem 1rem .25rem
