// Material Design theme: an elevated box (elevation 2), a menu with elevation 8, 48px rows.
// Every value can be changed by setting the custom property on .IZ-select and .IZ-select__menu.
@import "../common/main.styl"

.IZ-select,
.IZ-select__menu
  --iz-font-family: Roboto, "Helvetica Neue", Arial, sans-serif
  --iz-font-size: 16px
  --iz-font-weight: 400
  --iz-line-height: 1.5

  --iz-height: 48px
  --iz-padding-x: 16px
  --iz-color: rgba(0, 0, 0, .87)
  --iz-placeholder-color: rgba(0, 0, 0, .6)
  --iz-muted-color: rgba(0, 0, 0, .6)
  --iz-bg: #fff
  // transparent, so the error and focus borders do not change the size
  --iz-border-width: 1px
  --iz-border-color: transparent
  --iz-radius: 4px
  --iz-shadow: 0 3px 1px -2px rgba(0, 0, 0, .2), 0 2px 2px 0 rgba(0, 0, 0, .14), 0 1px 5px 0 rgba(0, 0, 0, .12)
  --iz-transition: border-color .2s ease-in-out, box-shadow .2s ease-in-out, background .8s

  --iz-focus-border-color: #1976d2
  --iz-focus-shadow: 0 2px 4px -1px rgba(0, 0, 0, .2), 0 4px 5px 0 rgba(0, 0, 0, .14), 0 1px 10px 0 rgba(0, 0, 0, .12)
  --iz-error-color: #ff5252
  --iz-error-focus-shadow: 0 2px 4px -1px rgba(255, 82, 82, .3), 0 4px 5px 0 rgba(255, 82, 82, .2), 0 1px 10px 0 rgba(255, 82, 82, .16)
  --iz-error-font-size: 12px
  --iz-error-margin: 4px
  --iz-error-padding: 0 16px
  --iz-success-color: #4caf50
  --iz-success-focus-shadow: 0 2px 4px -1px rgba(76, 175, 80, .3), 0 4px 5px 0 rgba(76, 175, 80, .2), 0 1px 10px 0 rgba(76, 175, 80, .16)

  --iz-disabled-bg: #fafafa
  --iz-disabled-color: rgba(0, 0, 0, .38)
  --iz-disabled-placeholder-color: rgba(0, 0, 0, .38)
  --iz-disabled-shadow: 0 0 0 1px rgba(0, 0, 0, .12)
  --iz-readonly-bg: #fff

  --iz-icon-color: rgba(0, 0, 0, .54)
  --iz-icon-hover-color: rgba(0, 0, 0, .87)
  --iz-icon-hover-bg: rgba(0, 0, 0, .08)
  --iz-spinner-color: #1976d2
  --iz-spinner-track-color: rgba(0, 0, 0, .12)

  --iz-chip-gap: 8px
  --iz-chip-padding-x: 12px
  --iz-chip-font-size: .875em
  --iz-chip-color: rgba(0, 0, 0, .87)
  --iz-chip-bg: #e0e0e0
  --iz-chip-border: 0 solid transparent
  --iz-chip-radius: 16px

  --iz-menu-z-index: 1060
  --iz-menu-offset: 4px
  --iz-menu-padding: 8px
  --iz-menu-bg: #fff
  --iz-menu-border: 0 solid transparent
  --iz-menu-radius: 4px
  --iz-menu-shadow: 0 5px 5px -3px rgba(0, 0, 0, .2), 0 8px 10px 1px rgba(0, 0, 0, .14), 0 3px 14px 2px rgba(0, 0, 0, .12)

  --iz-item-padding-y: 12px
  --iz-item-padding-x: 16px
  --iz-item-color: rgba(0, 0, 0, .87)
  --iz-item-hover-bg: rgba(0, 0, 0, .04)
  --iz-item-highlight-bg: rgba(0, 0, 0, .1)
  --iz-item-selected-color: #1976d2
  --iz-item-selected-bg: rgba(25, 118, 210, .08)
  --iz-item-disabled-color: rgba(0, 0, 0, .38)

  --iz-group-padding: 12px 16px 4px
  --iz-group-font-size: .875em
  --iz-group-font-weight: 500
  --iz-group-color: rgba(0, 0, 0, .6)

.IZ-select--sm,
.IZ-select__menu--sm
  --iz-font-size: 14px
  --iz-height: 40px
  --iz-padding-x: 12px
  --iz-chip-gap: 6px
  --iz-chip-padding-x: 10px
  --iz-chip-radius: 14px
  --iz-item-padding-y: 8px
  --iz-item-padding-x: 12px
  --iz-group-padding: 8px 12px 2px
  --iz-menu-padding: 4px
  --iz-error-padding: 0 12px

.IZ-select--lg,
.IZ-select__menu--lg
  --iz-font-size: 18px
  --iz-height: 56px
  --iz-padding-x: 20px
  --iz-chip-gap: 10px
  --iz-chip-padding-x: 14px
  --iz-chip-radius: 18px
  --iz-item-padding-y: 14px
  --iz-item-padding-x: 20px
  --iz-group-padding: 14px 20px 4px
  --iz-error-padding: 0 20px

.IZ-select__input,
.IZ-select__menu
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale

// ripple on press
.IZ-select__input:not(.IZ-select__input--disabled):not(.IZ-select__input--readonly)
  background-position: center

  &:hover
    background: #fbfbfb radial-gradient(circle, transparent 1%, #fbfbfb 1%) center / 15000%

  &:active
    background-color: #f0f0f0
    background-size: 100%
    transition: background 0s
