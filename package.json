{
  "name": "vue3-cool-select",
  "version": "1.0.0",
  "description": "Vue 3 select with autocomplete, slots and two themes (Bootstrap, Material Design). Vue 3 port of vue-cool-select.",
  "keywords": [
    "vue",
    "vue3",
    "select",
    "autocomplete",
    "dropdown",
    "combobox",
    "slots",
    "bootstrap",
    "material design"
  ],
  "license": "MIT",
  "author": "Anisur Rahaman",
  "contributors": [
    "Ilya Zelenko (author of the original vue-cool-select)"
  ],
  "main": "dist/vue3-cool-select.umd.js",
  "module": "dist/vue3-cool-select.mjs",
  "unpkg": "dist/vue3-cool-select.umd.js",
  "jsdelivr": "dist/vue3-cool-select.umd.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/vue3-cool-select.mjs",
      "require": "./dist/vue3-cool-select.umd.js"
    },
    "./themes/*": "./dist/themes/*",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "sideEffects": [
    "*.css",
    "*.styl"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.mjs",
    "build": "vite build && node scripts/build-themes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "stylus": "^0.64.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46"
  }
}
